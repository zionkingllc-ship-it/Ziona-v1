{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "autoIncrement": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "distribution": "internal"
    },
    "beta": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.ziona.app",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://api.ziona.app/graphql"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.ziona.app",
        "EXPO_PUBLIC_GRAPHQL_URL": "https://api.ziona.app/graphql"
      }
    }
  },
  "submit": {
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountZiona.json",
        "track": "internal"
      }
    },
    "beta": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountZiona.json",
        "track": "open"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountZiona.json",
        "track": "production"
      }
    }
  }
}

