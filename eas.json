{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "autoIncrement": true,
      "distribution": "internal",
      "env": { "FIREBASE_ENV": "staging" }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "FIREBASE_ENV": "staging" }
    },
    "production": {
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": { "FIREBASE_ENV": "prod" }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./serviceAccountZiona.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "onyeama.a.k@gmail.com",
        "ascAppId": "6768301878",
        "appleTeamId": "RLL2NX9J5Z"
      }
    }
  }
}